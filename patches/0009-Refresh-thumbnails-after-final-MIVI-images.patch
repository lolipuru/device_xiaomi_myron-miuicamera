Date: Sat, 3 Oct 2026 02:00:00 +0800
Subject: [PATCH] Refresh thumbnails after the final MIVI image is saved

Replace the quick-view bitmap when the final JPEG updates the same media URI.
Decode on the saver thread and check the displayed and pending URI again on
the UI thread so an older capture cannot replace a newer thumbnail.

---
diff --git a/smali/s7/e.smali b/smali/s7/e.smali
--- a/smali/s7/e.smali
+++ b/smali/s7/e.smali
@@ -632,7 +632,7 @@
 
     move-result v2
 
-    if-nez v2, :cond_10
+    if-nez v2, :refresh_final_thumbnail
 
     move-object v4, v14
 
@@ -648,6 +648,11 @@
     move-object/from16 v2, v27
 
     goto :goto_b
+
+    :refresh_final_thumbnail
+    move-object/from16 v2, v27
+
+    invoke-static {v2, v1, v14, v5}, Lcom/android/camera/compat/FinalThumbnailUpdater;->refresh(Lk7/z;LRh/r;Landroid/net/Uri;[B)V
 
     :cond_10
     if-eqz v27, :cond_f
