cc_binary {
    name: "vendor.xiaomi.hardware.misys-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.xiaomi.hardware.misys-service.rc"],
    vintf_fragments: ["vendor.xiaomi.hardware.misys-service.xml"],
    srcs: [
        "main.cpp",
        "MiSysImpl.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libutils",
        "vendor.xiaomi.hardware.misys.common-V3-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
